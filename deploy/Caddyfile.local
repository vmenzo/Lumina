:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8080 {
            transport http {
                read_timeout 120s
                write_timeout 120s
            }
        }
    }

    handle /raw/* {
        reverse_proxy api:8080
    }

    handle /webdav* {
        reverse_proxy api:8080
    }

    handle_path /img/* {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy imgproxy:8080
    }

    handle {
        reverse_proxy web:3000
    }
}
