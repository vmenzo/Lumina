# ==============================================================================
# LUMINA // 光匣多人图床 - 生产环境配置文件 (.env)
# 运行初始化脚本自动生成安全密钥: bash scripts/init-env.sh
# ==============================================================================

# --- 域名配置 (动静分离，Caddy 自动签发 HTTPS 证书) ---
APP_DOMAIN=img.example.com
CDN_DOMAIN=i.example.com
APP_PUBLIC_URL=https://img.example.com
CDN_PUBLIC_URL=https://i.example.com

# --- 首次启动自动创建的管理员账号 ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_StrongPass123!

# --- 安全密钥 (请务必修改，可运行 scripts/init-env.sh 自动生成) ---
JWT_SECRET=replace_with_at_least_32_random_characters_secret_key
LOCAL_SIGN_SECRET=replace_with_another_32_random_characters_sign_key

# --- 数据库 PostgreSQL ---
POSTGRES_DB=lumina
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina_pg_strong_password

# --- Redis 缓存与限流 ---
REDIS_PASSWORD=lumina_redis_strong_password

# --- 存储引擎 1: 本地 NVMe 磁盘 ---
LOCAL_STORAGE_PATH=/data/uploads
LOCAL_ENABLED=true

# --- 存储引擎 2: Cloudflare R2 (兼容所有 S3 协议对象存储) ---
R2_ENABLED=false
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=lumina-images
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_URL=https://r2.example.com

# --- 智能路由默认阈值 (超过该大小自动路由到 R2，默认 5MB) ---
SMART_ROUTE_THRESHOLD_MB=5

# --- imgproxy 动态图片处理与防刷签名 (必须为偶数长度十六进制字符串) ---
IMGPROXY_KEY=7365637265746b657931323334353637383930616263646566
IMGPROXY_SALT=73656372657473616c7431323334353637383930616263646566

# --- Cloudflare CDN 缓存刷新 (封禁违规图片时自动 Purge 边缘缓存，可选) ---
CF_ZONE_ID=
CF_API_TOKEN=

# --- 异步内容审核 Webhook (可选，留空则走人工审核队列或按策略自动放行) ---
MODERATION_WEBHOOK_URL=
MODERATION_WEBHOOK_SECRET=

# --- v2 OAuth & Webhook Extensions (Optional) ---
UPLOAD_WEBHOOK_URL=
UPLOAD_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- v4 AI 视觉识图与自动打标 (OpenAI / Gemini / Qwen-VL / Ollama 兼容，可选) ---
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- v4 SMTP 邮件服务与找回密码 (可选) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
